{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevBuddy Settings",
  "type": "object",
  "required": ["schema_version", "skill", "governance", "orchestration", "loops", "memory", "tools", "environments", "quality", "adapters"],
  "properties": {
    "schema_version": {"const": 1},
    "skill": {"type": "object", "required": ["name", "common_spec_version", "internal_language", "user_language"]},
    "governance": {"type": "object"},
    "orchestration": {"type": "object", "required": ["max_concurrency", "task_timeout", "retry_limit", "approved_models", "approved_effort_levels", "require_model_and_effort_per_dispatch", "model_effort_selection_policy", "escalation_requires_recorded_reason", "user_update_events"]},
    "loops": {"type": "object"},
    "memory": {"type": "object", "required": ["default_root", "project_settings_path", "locator_key", "knowledge_root", "project_registry_key"]},
    "tools": {"type": "object"},
    "environments": {"type": "object"},
    "quality": {"type": "object"},
    "adapters": {"type": "object", "required": ["claude", "codex"]}
  }
}
