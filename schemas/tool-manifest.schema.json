{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevBuddy Tool Manifest",
  "type": "object",
  "required": ["id", "runtime", "permission_tier", "risk", "scope", "input", "output"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "runtime": {"enum": ["dotnet", "python"]},
    "permission_tier": {"enum": [0, 1, 2]},
    "risk": {"enum": ["read-only", "workspace-write", "database-read"]},
    "scope": {"type": "object"},
    "input": {"type": "object"},
    "output": {"type": "object"}
  },
  "additionalProperties": true
}
