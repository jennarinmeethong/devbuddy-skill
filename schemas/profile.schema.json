{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevBuddy Profile",
  "type": "object",
  "required": ["name", "packages"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "packages": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "hosts": {"type": "array", "items": {"enum": ["codex", "claude-code", "opencode"]}, "minItems": 1, "uniqueItems": true}
  },
  "additionalProperties": false
}
